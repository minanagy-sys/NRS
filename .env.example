DATABASE_URL="postgresql://USER@localhost:5432/nouvelage_sales?schema=public"
MCP_BASE_URL="https://mcp.nouvelageclinic.com"
PORT=3020
# 32 random bytes as hex — encrypts MCP tokens at rest. Rotating it signs everyone out.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_KEY=""

# Unlocks editing of target sheets and name mappings. Shared secret — the MCP
# cannot tell us who signed in, so this guards writes instead of a user role.
ADMIN_PASSPHRASE=""
# Loopback behind a reverse proxy; 0.0.0.0 only on a managed platform.
BIND_HOST="127.0.0.1"

# The Finance report (collections, payables, sold-vs-issued, expiry) is HIDDEN by
# default as of 2026-08-19. Its code, its four sections and every row of its data
# are still here — this switch is the only thing standing between them and the
# webapp. Set to 1 to serve /finance and /api/finance/* again, and set
# `enabled: true` on the Finance entry in public/nav.js to put the sidebar link
# back. Both are needed: the link alone would 404, and the routes alone would be
# reachable only by typing the URL.
# FINANCE_ENABLED=1

# Report 03 (Marketing) reads Meta and Instagram through Supermetrics. The
# licence currently in use is scoped to the MCP connector (app_id CLAUDE) and
# issues NO server key, so the unattended path is not usable yet — until an
# API-tier subscription is in place, fill the cache with:
#   node scripts/sync-meta.js --source bootstrap --file data/meta-bootstrap.json
# and check the feed still means what it meant with:
#   node scripts/verify-supermetrics.js
# The server API key. Find it in the Supermetrics hub (Manage > API queries, or
# the subscription page) and paste it HERE — never into a chat, a commit or a
# ticket. .env is gitignored; that is the only place it belongs.
#
# The allowance is 50,000 rows a month and it is metered in the ApiQuery table,
# because its failure mode is silent: spend it and report 03 simply stops
# refreshing. Measured costs:
#     a full 15-month backfill   26,712 rows  (53% of the month — once, not twice)
#     one day of activity           ~153 rows
#     daily 3-day window          13,800 rows/month   <- the scheduled run
#     daily 7-day window          32,200 rows/month   (no room left to re-pull)
# Rows pulled through the interactive connector do NOT count against it.
#
#   node scripts/sync-meta.js --days 3 --source api      # the scheduled run
#   node scripts/verify-supermetrics.js --source api     # prove the feed still means what it meant
SUPERMETRICS_API_KEY=""
SUPERMETRICS_TEAM_ID="1027414"
# The subscription id, used only to print the right link when Supermetrics
# refuses an account for want of a prioritised slot.
SUPERMETRICS_LICENCE_ID="1743532"

# ---------------------------------------------------------------------------
# Added 2026-10-04: settings the code reads that this file never listed.
# ---------------------------------------------------------------------------

# The address people open the app at. Sets the OAuth callback and whether the
# session cookie is marked Secure (https). Defaults to http://localhost:$PORT.
PUBLIC_ORIGIN=""

# The account the UNATTENDED sync signs in with (cron has no browser, and the
# MCP offers neither client-credentials nor a password grant). Make it a
# read-only Odoo user. Alternatively set MCP_TOKEN to a token you already hold.
MCP_USER=""
MCP_PASSWORD=""
MCP_TOKEN=""

# The Finance report is hidden, not deleted. "1" turns its routes back on; its
# sidebar entry also has to be re-enabled in public/nav.js.
FINANCE_ENABLED=""

# Server log level: fatal | error | warn | info | debug. Default: info.
LOG_LEVEL=""
